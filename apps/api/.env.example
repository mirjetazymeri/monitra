APP_NAME=MonitraZ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=monitraz
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# --- MonitraZ -------------------------------------------------------------
# Origin of the Next.js frontend (used for CORS).
FRONTEND_URL=http://localhost:3000
# Hosts that receive stateful (cookie/session) Sanctum authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# HTTP check transport limits.
MONITRAZ_CONNECT_TIMEOUT=5
MONITRAZ_REQUEST_TIMEOUT=10
MONITRAZ_MAX_RESPONSE_BYTES=1048576
# DNS lookup limits (glibc resolvers): seconds per attempt, attempts per nameserver.
MONITRAZ_DNS_TIMEOUT=2
MONITRAZ_DNS_ATTEMPTS=2
MONITRAZ_ALLOWED_PORTS=80,443,8080,8443
MONITRAZ_SCHEDULER_BATCH_SIZE=50
MONITRAZ_MAX_ENDPOINTS_PER_USER=50
# Days of check history to keep (pruned daily by monitraz:prune-checks).
MONITRAZ_RETENTION_DAYS=90

# Local demo account created by `php artisan db:seed` (local/testing only).
DEMO_USER_EMAIL=demo@monitraz.test
DEMO_USER_PASSWORD=
